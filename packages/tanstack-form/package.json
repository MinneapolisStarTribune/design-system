{
  "name": "@minneapolisstartribune/design-system-tanstack-form",
  "version": "1.1.0",
  "description": "TanStack Form (v1) field adapters for @minneapolisstartribune/design-system",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MinneapolisStarTribune/design-system",
    "directory": "packages/tanstack-form"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && cross-env NODE_ENV=production vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0 --ignore-path ../../.eslintignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@minneapolisstartribune/design-system": "^4.1.0",
    "@tanstack/react-form": "^1.33.1",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@minneapolisstartribune/design-system": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "cross-env": "10.1.0",
    "eslint": "8.57.1",
    "jsdom": "27.2.0",
    "prettier": "3.6.2",
    "prettier-plugin-sort-json": "4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rollup-preserve-directives": "1.1.3",
    "typescript": "5.9.2",
    "vite": "6.4.1",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.4"
  }
}
